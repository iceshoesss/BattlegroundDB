<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>BattlegroundDB</AssemblyName>
    <RootNamespace>BattlegroundDB</RootNamespace>
    <Version>2.0.0</Version>
    <Description>Battlegrounds card database (hsbg.cards powered)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\bg_cards.json">
      <LogicalName>BattlegroundDB.Data.bg_cards.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
